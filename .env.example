# ─── Base de données Turso ───────────────────────────────────────────────────
# Obtenez vos clés sur https://turso.tech
TURSO_DATABASE_URL=libsql://votre-base.turso.io
TURSO_AUTH_TOKEN=votre_token_ici

# ─── API CIVIX (optionnel en développement local) ─────────────────────────────
# https://civix.fr
CIVIX_API_KEY=

# ─── Stripe (optionnel) ───────────────────────────────────────────────────────
# https://stripe.com/docs/keys
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Vercel Deploy Hook (utilisé par le cron GitHub Actions) ─────────────────
# Générez-le dans Vercel → Settings → Git → Deploy Hooks
VERCEL_DEPLOY_HOOK_URL=
